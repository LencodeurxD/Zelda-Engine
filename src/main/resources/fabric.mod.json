{
	"schemaVersion": 1,
	"id": "ocarina_engine",
	"version": "${version}",
	"name": "Ocarina Engine",
	"description": "A new movement and camera engine inspired by Zelda: Ocarina of Time.",
	"authors": [
		"You"
	],
	"license": "All-Rights-Reserved",
	"icon": "assets/ocarina_engine/icon.png",
	"environment": "*",
